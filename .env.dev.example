# ============================================================================
# FEDR - DEV / SIMULATION profile  (copy to .env; `docker compose -f docker-compose.yml -f docker-compose.dev.yml up`)
# Synthetic multi-venue market, simulated balances. No exchange, RPC or Gateway access needed.
# Nothing in this profile can move real funds.
# ============================================================================
FEDR_PORT=8935
FEDR_LOG_LEVEL=DEBUG
FEDR_LOG_JSON=false
FEDR_DEFAULT_MODE=simulation
FEDR_DATA_DIR=/data
FEDR_DEMO_SEED=42
# Token for the UI/API. Leave empty to have one generated into /data/config/ui-token (mode 0600) at first start.
FEDR_AUTH_TOKEN=
FEDR_LIVE_TRADING_ALLOWED=false
FEDR_GATEWAY_ENABLED=false
GATEWAY_PASSPHRASE=dev-only-not-a-secret-passphrase
FEDR_TELEMETRY_ENABLED=false
