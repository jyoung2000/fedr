# ============================================================================
# FEDR - PAPER profile  (copy to .env; `docker compose up -d` or `... -f docker-compose.paper.yml up -d`)
# Real public market data, simulated balances and execution. Exchange API keys are OPTIONAL here (public
# order books need none). The Gateway container provides DEX quotes; it holds no wallet in paper mode.
# ============================================================================
FEDR_PORT=8935
FEDR_LOG_LEVEL=INFO
FEDR_LOG_JSON=true
FEDR_DEFAULT_MODE=paper
FEDR_DATA_DIR=/data
# Strongly recommended even for paper: the UI can change settings and hold API keys.
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
FEDR_AUTH_TOKEN=
# Master key for credentials/wallet keys at rest (base64, 32 bytes). Empty = generated into /data/config/master.key.
FEDR_MASTER_KEY=
FEDR_LIVE_TRADING_ALLOWED=false
FEDR_GATEWAY_ENABLED=true
FEDR_GATEWAY_URL=http://gateway:15888
FEDR_GATEWAY_API_KEY=
# Long random passphrase for the Gateway container (encrypts Gateway-side keystores).
GATEWAY_PASSPHRASE=change-me-to-a-long-random-passphrase
GATEWAY_IMAGE=hummingbot/gateway:version-2.16.0
# Optional RPC endpoints for gas oracles (public endpoints work; rate limits apply)
FEDR_RPC_ETHEREUM=
FEDR_RPC_BASE=
FEDR_RPC_ARBITRUM=
FEDR_RPC_SOLANA=
FEDR_TELEMETRY_ENABLED=false
