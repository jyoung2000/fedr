# ============================================================================
# FEDR - LIVE profile  (copy to .env; `docker compose -f docker-compose.yml -f docker-compose.live.yml up -d`)
# READ docs/OPERATIONS.md AND docs/SECURITY.md FIRST.
# FEDR_LIVE_TRADING_ALLOWED=true does NOT start live trading. The container still boots in PAPER; live mode
# is entered only through the readiness checklist + typed confirmation in Settings > Live, and the
# emergency stop / circuit breakers can revert it at any time. Exchange keys: TRADE + READ only, withdraw OFF.
# ============================================================================
FEDR_PORT=8935
FEDR_BIND=0.0.0.0           # compose publishes 127.0.0.1:8935 only; put TLS + auth in front for remote access
FEDR_LOG_LEVEL=INFO
FEDR_LOG_JSON=true
FEDR_DEFAULT_MODE=paper     # LIVE can never be a boot default (startup validation refuses it)
FEDR_DATA_DIR=/data
FEDR_AUTH_TOKEN=            # REQUIRED (>= 16 random chars)
FEDR_MASTER_KEY=            # REQUIRED in practice: generate once, store offline; rotating it invalidates stored secrets
FEDR_SECURE_COOKIES=true    # only behind HTTPS
FEDR_ALLOWED_ORIGINS=       # extra origins for the UI if served behind a different host name
FEDR_LIVE_TRADING_ALLOWED=true
FEDR_GATEWAY_ENABLED=true
FEDR_GATEWAY_URL=http://gateway:15888
FEDR_GATEWAY_API_KEY=       # set GATEWAY_REQUIRE_AUTH on the Gateway and put the same token here
GATEWAY_PASSPHRASE=         # REQUIRED: long random passphrase
GATEWAY_IMAGE=hummingbot/gateway:version-2.16.0
# Mainnet RPCs (your own nodes or paid providers; public endpoints are rate-limited and unreliable for execution)
FEDR_RPC_ETHEREUM=
FEDR_RPC_BASE=
FEDR_RPC_ARBITRUM=
FEDR_RPC_OPTIMISM=
FEDR_RPC_POLYGON=
FEDR_RPC_BSC=
FEDR_RPC_AVALANCHE=
FEDR_RPC_SOLANA=
# MEV-aware submission (opt-in, see docs/MEV.md)
FEDR_EVM_PRIVATE_RPC=
FEDR_JITO_BLOCK_ENGINE_URL=
# Flash-loan contracts (deploy and verify yourself; audited status: NOT audited - see docs/PRODUCTION_VERIFICATION_MATRIX.md)
FEDR_FLASHLOAN_CONTRACT_ETHEREUM=
FEDR_FLASHLOAN_CONTRACT_ARBITRUM=
FEDR_FLASHLOAN_CONTRACT_BASE=
FEDR_FLASHLOAN_CONTRACT_OPTIMISM=
FEDR_FLASHLOAN_CONTRACT_POLYGON=
FEDR_TELEMETRY_ENABLED=false
