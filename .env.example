# ============================================================================
# FEDR - self-hosted crypto arbitrage platform - environment configuration
# Copy to .env. Everything user-facing (mode, risk, strategies, pairs) is
# configured in the web UI at http://localhost:8935 and persisted in /data.
# ============================================================================

# --- Core -------------------------------------------------------------------
FEDR_PORT=8935
FEDR_LOG_LEVEL=INFO
FEDR_LOG_JSON=false
# Boot mode on first start (paper|simulation|testnet). LIVE can never be a boot default.
FEDR_DEFAULT_MODE=paper

# --- Security ---------------------------------------------------------------
# Master key for encrypting exchange credentials and wallet keys at rest (base64, 32 bytes).
# Leave empty to auto-generate into /data/config/master.key (mode 0600) on first start.
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FEDR_MASTER_KEY=
# UI / API access token. Strongly recommended; REQUIRED before live activation.
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
FEDR_AUTH_TOKEN=
# Hard gate: live trading is impossible unless this is true AND the UI activation workflow is completed.
FEDR_LIVE_TRADING_ALLOWED=false
# Extra CORS origins (comma separated). Same-origin is always allowed.
FEDR_ALLOWED_ORIGINS=
FEDR_SECURE_COOKIES=false

# --- Gateway (Hummingbot Gateway - DEX middleware, internal network only) ----
FEDR_GATEWAY_ENABLED=true
FEDR_GATEWAY_URL=http://gateway:15888
# Long random passphrase used by Gateway to encrypt wallet keystores. REQUIRED for the gateway service.
GATEWAY_PASSPHRASE=change-me-to-a-long-random-passphrase
# Pin the Gateway image tag (verified against 2.16.0 API)
GATEWAY_IMAGE=hummingbot/gateway:version-2.16.0

# --- RPC endpoints (optional; used for gas oracles, deposits/withdrawals and flash loans) ---
FEDR_RPC_ETHEREUM=
FEDR_RPC_BASE=
FEDR_RPC_ARBITRUM=
FEDR_RPC_OPTIMISM=
FEDR_RPC_POLYGON=
FEDR_RPC_BSC=
FEDR_RPC_AVALANCHE=
FEDR_RPC_SOLANA=
FEDR_RPC_SEPOLIA=
FEDR_RPC_BASE_SEPOLIA=
FEDR_RPC_SOLANA_DEVNET=

# --- MEV-aware submission (opt-in; see docs/MEV.md) --------------------------
# Ethereum mainnet private transaction RPC, e.g. https://rpc.flashbots.net or https://rpc.mevblocker.io
FEDR_EVM_PRIVATE_RPC=
# Jito block engine for Solana bundles (not used by Gateway swaps; reserved for the flash-loan/atomic path)
FEDR_JITO_BLOCK_ENGINE_URL=

# --- Flash loan contract deployments (never auto-deployed; see contracts/README.md) ---
FEDR_FLASHLOAN_CONTRACT_ETHEREUM=
FEDR_FLASHLOAN_CONTRACT_ARBITRUM=
FEDR_FLASHLOAN_CONTRACT_BASE=
FEDR_FLASHLOAN_CONTRACT_OPTIMISM=
FEDR_FLASHLOAN_CONTRACT_POLYGON=
FEDR_FLASHLOAN_CONTRACT_SEPOLIA=

# --- Privacy ----------------------------------------------------------------
FEDR_TELEMETRY_ENABLED=false
