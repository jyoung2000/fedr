# ============================================================================
# FEDR - TESTNET profile  (copy to .env; `docker compose -f docker-compose.yml -f docker-compose.testnet.yml up -d`)
# Real order flow against exchange SANDBOX accounts and test networks (Sepolia, Solana devnet) with
# test funds only. Use SANDBOX/TESTNET API keys - never production keys. Withdraw permission must be OFF.
# ============================================================================
FEDR_PORT=8935
FEDR_LOG_LEVEL=INFO
FEDR_LOG_JSON=true
FEDR_DEFAULT_MODE=testnet
FEDR_DATA_DIR=/data
FEDR_AUTH_TOKEN=            # REQUIRED (>= 16 chars); startup refuses testnet/live-capable configs without it
FEDR_MASTER_KEY=            # base64 32 bytes; keep a copy offline - wallet keys are unusable without it
FEDR_LIVE_TRADING_ALLOWED=false
FEDR_GATEWAY_ENABLED=true
FEDR_GATEWAY_URL=http://gateway:15888
FEDR_GATEWAY_API_KEY=
GATEWAY_PASSPHRASE=change-me-to-a-long-random-passphrase
GATEWAY_IMAGE=hummingbot/gateway:version-2.16.0
# Test-network RPCs (required for on-chain testnet checks, deposits/withdrawals of test funds)
FEDR_RPC_SEPOLIA=
FEDR_RPC_BASE_SEPOLIA=
FEDR_RPC_SOLANA_DEVNET=
# Flash-loan contract on Sepolia (deploy it yourself; never auto-deployed)
FEDR_FLASHLOAN_CONTRACT_SEPOLIA=
FEDR_TELEMETRY_ENABLED=false
